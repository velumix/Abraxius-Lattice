<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:Abraxius.Lattice.ViewModels"
    x:Class="Abraxius.Lattice.Views.MainWindow"
    x:Name="Root"
    x:DataType="vm:MainWindowViewModel"
    Title="Lattice"
    Width="1600"
    Height="960"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="52,*,30">
        <Border
            Grid.Row="0"
            Background="{DynamicResource Lattice.Surface}"
            BorderBrush="{DynamicResource Lattice.Border}"
            BorderThickness="0,0,0,1">
            <Grid Margin="12,0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Border
                        Width="28"
                        Height="28"
                        CornerRadius="6"
                        Background="{DynamicResource Lattice.AccentMuted}">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="avares://Abraxius.Lattice/Assets/Lattice.png"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Classes="SectionTitle" Text="LATTICE" />
                        <TextBlock Classes="Meta" Text="{Binding WorkspaceName}" />
                    </StackPanel>
                    <Border
                        Margin="8,0,0,0"
                        Padding="7,3"
                        CornerRadius="4"
                        Background="{DynamicResource Lattice.SurfaceRaised}"
                        BorderBrush="{DynamicResource Lattice.Border}"
                        BorderThickness="1">
                        <TextBlock Classes="Meta" Text="{Binding BranchLabel}" />
                    </Border>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Classes="Ghost"
                    HorizontalAlignment="Center"
                    Width="360"
                    Command="{Binding OpenCommandPaletteCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Grid.Column="0"
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Foreground="{DynamicResource Lattice.TextMuted}"
                            Kind="{Binding SearchIcon}" />
                        <TextBlock
                            Grid.Column="1"
                            Classes="Secondary"
                            HorizontalAlignment="Left"
                            Text="Search resources, tools, traces, commands..." />
                        <Border
                            Grid.Column="2"
                            Padding="5,1"
                            CornerRadius="3"
                            Background="{DynamicResource Lattice.Background}">
                            <TextBlock Classes="Meta" Text="Ctrl K" />
                        </Border>
                    </Grid>
                </Button>

                <Button
                    Grid.Column="2"
                    Classes="Ghost"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Settings">
                    <materialIcons:MaterialIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource Lattice.TextSecondary}"
                        Kind="{Binding SettingsIcon}" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="56,280,4,*,4,340">
            <Border
                Grid.Column="0"
                Background="{DynamicResource Lattice.Surface}"
                BorderBrush="{DynamicResource Lattice.Border}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto">
                    <ListBox
                        Grid.Row="0"
                        Classes="NavRail"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <Grid>
                                    <materialIcons:MaterialIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Lattice.TextSecondary}"
                                        Kind="{Binding IconKind}" />
                                    <Ellipse
                                        Width="5"
                                        Height="5"
                                        Margin="0,0,5,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        IsVisible="{Binding HasAttention}"
                                        Fill="{DynamicResource Lattice.Warning}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        Grid.Row="1"
                        Classes="Ghost"
                        Width="44"
                        Height="44"
                        Margin="6"
                        HorizontalAlignment="Center"
                        Command="{Binding ToggleNavigationCommand}"
                        ToolTip.Tip="Expand navigation">
                        <materialIcons:MaterialIcon
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource Lattice.TextMuted}"
                            Kind="{Binding MenuIcon}" />
                    </Button>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{DynamicResource Lattice.Surface}"
                BorderBrush="{DynamicResource Lattice.Border}"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="44,*">
                    <Border
                        Grid.Row="0"
                        Padding="12,0"
                        BorderBrush="{DynamicResource Lattice.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="SectionTitle"
                                VerticalAlignment="Center"
                                Text="{Binding ContextPaneTitle}" />
                            <Button
                                Grid.Column="1"
                                Classes="Ghost"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding CloseContextPaneCommand}"
                                ToolTip.Tip="Close panel">
                                <TextBlock Text="×" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding CurrentContextPane}" />
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="2"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Background="{DynamicResource Lattice.Splitter}" />

            <Grid
                Grid.Column="3"
                RowDefinitions="*,4,Auto"
                Background="{DynamicResource Lattice.Background}">
                <ContentControl Grid.Row="0" Content="{Binding CurrentWorkspace}" />
                <GridSplitter
                    Grid.Row="1"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True"
                    IsVisible="{Binding IsBottomPanelVisible}"
                    Background="{DynamicResource Lattice.Splitter}" />
                <Border
                    Grid.Row="2"
                    Height="{Binding BottomPanelHeight}"
                    IsVisible="{Binding IsBottomPanelVisible}"
                    Background="{DynamicResource Lattice.Surface}"
                    BorderBrush="{DynamicResource Lattice.Border}"
                    BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="36,*">
                        <Grid Grid.Row="0" Margin="8,0" ColumnDefinitions="*,Auto">
                            <TabControl
                                Grid.Column="0"
                                ItemsSource="{Binding BottomTabs}"
                                SelectedItem="{Binding SelectedBottomTab}" />
                            <Button
                                Grid.Column="1"
                                Classes="Ghost"
                                Width="30"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                Command="{Binding CollapseBottomPanelCommand}">
                                <TextBlock Text="⌄" FontSize="15" />
                            </Button>
                        </Grid>
                        <ContentControl Grid.Row="1" Content="{Binding CurrentBottomPanel}" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter
                Grid.Column="4"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Background="{DynamicResource Lattice.Splitter}" />

            <Border
                Grid.Column="5"
                Background="{DynamicResource Lattice.Surface}"
                BorderBrush="{DynamicResource Lattice.Border}"
                BorderThickness="1,0,0,0">
                <Grid RowDefinitions="44,*">
                    <Border
                        Grid.Row="0"
                        Padding="12,0"
                        BorderBrush="{DynamicResource Lattice.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="SectionTitle"
                                VerticalAlignment="Center"
                                Text="{Binding InspectorTitle}" />
                            <Button
                                Grid.Column="1"
                                Classes="Ghost"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding CloseInspectorCommand}">
                                <TextBlock Text="×" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding CurrentInspector}" />
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Background="{DynamicResource Lattice.Surface}"
            BorderBrush="{DynamicResource Lattice.Border}"
            BorderThickness="0,1,0,0">
            <Grid Margin="10,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Grid Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse
                            Classes="StudioPulse"
                            Width="9"
                            Height="9"
                            Fill="{DynamicResource Lattice.Success}"
                            IsVisible="{Binding StudioConnected}" />
                        <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{Binding StudioStatusBrush}" />
                    </Grid>
                    <TextBlock Classes="Meta" VerticalAlignment="Center" Text="{Binding StudioStatusShort}" />
                    <TextBlock
                        Classes="Meta"
                        VerticalAlignment="Center"
                        Text="{Binding StudioLatencyText}"
                        ToolTip.Tip="Round-trip time between this desktop app and the local Lattice bridge; Studio MCP latency is measured separately." />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="18,0,0,0" Classes="Meta" VerticalAlignment="Center" Text="{Binding GitStatusShort}" />
                <TextBlock Grid.Column="2" Margin="18,0,0,0" Classes="Meta" VerticalAlignment="Center" Text="{Binding BridgeStatusShort}" />
                <TextBlock Grid.Column="3" Margin="18,0,0,0" Classes="Meta" VerticalAlignment="Center" Text="{Binding IndexStatusShort}" />
                <TextBlock Grid.Column="5" Classes="Meta" VerticalAlignment="Center" Text="{Binding LatticeVersion}" />
            </Grid>
        </Border>
    </Grid>
</Window>
