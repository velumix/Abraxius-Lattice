<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:Abraxius.Lattice.ViewModels"
    x:Class="Abraxius.Lattice.Views.WorkspaceHomeView"
    x:DataType="vm:WorkspaceHomeViewModel">
    <Grid Margin="24" RowDefinitions="Auto,20,Auto,20,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="PageTitle" Text="{Binding WorkspaceName}" />
                <TextBlock Classes="Secondary" Margin="0,3,0,0" Text="{Binding WorkspaceDescription}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Primary" Command="{Binding SelectFolderCommand}" Content="Open folder" />
        </Grid>

        <Border Grid.Row="2" Classes="Panel" Padding="16">
            <Grid ColumnDefinitions="*,1,*,1,*,1,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="Meta" Text="STUDIO" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding StudioStatusBrush}" />
                        <TextBlock Classes="SectionTitle" Text="{Binding StudioStatus}" />
                    </StackPanel>
                    <TextBlock Classes="Secondary" Text="{Binding StudioDetail}" />
                </StackPanel>
                <Separator Grid.Column="1" />
                <StackPanel Grid.Column="2" Margin="16,0" Spacing="4">
                    <TextBlock Classes="Meta" Text="REPOSITORY" />
                    <TextBlock Classes="SectionTitle" Text="{Binding GitBranch}" />
                    <TextBlock Classes="Secondary" Text="{Binding GitDetail}" />
                </StackPanel>
                <Separator Grid.Column="3" />
                <StackPanel Grid.Column="4" Margin="16,0" Spacing="4">
                    <TextBlock Classes="Meta" Text="INDEX" />
                    <TextBlock Classes="SectionTitle" Text="{Binding IndexStatus}" />
                    <TextBlock Classes="Secondary" Text="{Binding IndexDetail}" />
                </StackPanel>
                <Separator Grid.Column="5" />
                <StackPanel Grid.Column="6" Margin="16,0,0,0" Spacing="4">
                    <TextBlock Classes="Meta" Text="PROVIDERS" />
                    <TextBlock Classes="SectionTitle" Text="{Binding ProviderStatus}" />
                    <TextBlock Classes="Secondary" Text="{Binding ProviderDetail}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="2*,16,*">
            <Border Grid.Column="0" Classes="Panel">
                <Grid RowDefinitions="44,*">
                    <Border Grid.Row="0" Padding="14,0" BorderBrush="{DynamicResource Lattice.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Classes="SectionTitle" VerticalAlignment="Center" Text="Recent activity" />
                    </Border>
                    <ListBox Grid.Row="1" Classes="DenseList" ItemsSource="{Binding RecentActivity}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                <Grid MinHeight="42" Margin="12,0" ColumnDefinitions="24,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" Kind="{Binding IconKind}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="Body" Text="{Binding Title}" />
                                        <TextBlock Classes="Meta" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="Meta" VerticalAlignment="Center" Text="{Binding TimeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="Panel">
                <Grid RowDefinitions="44,*">
                    <Border Padding="14,0" BorderBrush="{DynamicResource Lattice.Border}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="SectionTitle" VerticalAlignment="Center" Text="Diagnostics" />
                            <TextBlock Grid.Column="1" Classes="Meta" VerticalAlignment="Center" Text="{Binding DiagnosticSummary}" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" Classes="DenseList" ItemsSource="{Binding Diagnostics}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiagnosticSummaryViewModel">
                                <Grid Margin="12,8" ColumnDefinitions="4,10,*">
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{Binding SeverityBrush}" />
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Classes="Body" Text="{Binding Title}" />
                                        <TextBlock Classes="Meta" Text="{Binding ResourceName}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
