<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:Abraxius.Lattice.ViewModels"
    x:Class="Abraxius.Lattice.Views.ToolsView"
    x:DataType="vm:ToolsViewModel">
    <Grid RowDefinitions="64,*">
        <Border Grid.Row="0" Background="{DynamicResource Lattice.Surface}" BorderBrush="{DynamicResource Lattice.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Classes="CommandSearch" Text="{Binding SearchQuery}" PlaceholderText="Search tools, capabilities, providers..." />
                <TextBlock Grid.Column="1" Classes="Meta" VerticalAlignment="Center" Text="{Binding ResultCountText}" />
            </Grid>
        </Border>
        <ListBox Grid.Row="1" Classes="DenseList" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolItemViewModel">
                    <Border Padding="16,12" BorderBrush="{DynamicResource Lattice.Border}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="5" Background="{DynamicResource Lattice.SurfaceRaised}">
                                <materialIcons:MaterialIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Lattice.TextSecondary}" Kind="{Binding IconKind}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
                                <TextBlock Classes="SectionTitle" Text="{Binding DisplayName}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Meta" Text="{Binding ProviderName}" />
                                    <TextBlock Classes="Meta" Text="·" />
                                    <TextBlock Classes="Meta" Text="{Binding CapabilityText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3">
                                <TextBlock Classes="Secondary" HorizontalAlignment="Right" Foreground="{Binding AvailabilityBrush}" Text="{Binding AvailabilityText}" />
                                <TextBlock Classes="Meta" HorizontalAlignment="Right" Text="{Binding TrustText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
